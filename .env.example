# Required
SECRET_KEY=generate-a-random-64-char-hex
DATABASE_URL=sqlite:///./data/socratic_learning.db
# Docker Compose uses an absolute path instead:
# DATABASE_URL=sqlite:////app/data/socratic_learning.db
CORS_ORIGIN=http://localhost

# Optional
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# User LLM patrol scheduler (docker compose service: user-llm-patrol)
# USER_LLM_PATROL_RUN_AT=03:00
# USER_LLM_PATROL_ARGS="--sql --repair --fail-on-issues"
# USER_LLM_PATROL_RUN_ON_START=0
# Feishu custom bot webhook (optional; patrol failures / dirty rows push here)
# USER_LLM_PATROL_ALERT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# USER_LLM_PATROL_SECRET=your-feishu-sign-secret
